{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@zero/*": ["./src/lib/*"],
      "@app/*": ["./src/application/*" ]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist", "build"]
}
